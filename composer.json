{
    "name": "nicesome/think-queue-rabbitmq",
    "description": "RabbitMQ driver for ThinkPHP6 Queue.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "nicesome",
            "email": "nicesome@qq.com"
        }
    ],
    "require": {
        "php": "^7.1 || >= 8.0",
        "php-amqplib/php-amqplib": "^3.0",
        "topthink/think-queue": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^6.2"
    },
    "autoload": {
        "psr-4": {
            "Linzc\\ThinkQueueRabbitMQ\\": "src/"
        }
    },
    "extra": {
        "think": {
            "services": [
                "Linzc\\ThinkQueueRabbitMQ\\queue\\Service"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
